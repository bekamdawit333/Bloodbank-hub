# ─────────────────────────────────────────────────────────────
# Blood Bank Hub - Environment Configuration
# Copy this file to ".env" and fill in your real secrets.
# NEVER commit the real ".env" (it is git-ignored).
# ─────────────────────────────────────────────────────────────

# ── Backend server ──
PORT=5000

# ── PostgreSQL (inside Docker network the host is "postgres") ──
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=bloodbank

# Full connection strings.
# NOTE: keep the password here in sync with DB_PASSWORD above!
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@postgres:5432/bloodbank?schema=public
LAB_DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@postgres:5432/bloodbank_lab?schema=public

# ── Security ──
JWT_SECRET=

# DEV ONLY: print verification/reset codes to backend logs when no email
# provider is configured. NEVER enable this in production.
SHOW_OTP_IN_LOGS=false

# ── Third-party API keys (leave EMPTY to run in local dev/mock mode) ──
# Brevo (transactional email): https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# SMSEthiopia: https://smsethiopia.com
SMS_ETHIOPIA_KEY=

# ── Frontend ──
VITE_API_URL=http://localhost:5000/api

# ── Database seeding (set true ONCE on a fresh database if desired) ──
SEED_DB=false
