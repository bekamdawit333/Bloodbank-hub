
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  role          String   // 'admin', 'station', 'laboratory', 'warehouse', 'hospital', 'donor'
  status        String   @default("pending") // 'pending', 'approved', 'rejected'
  entity_name   String
  created_at    DateTime @default(now())


  donorProfile            Donor?                   @relation("UserToDonor")
  warehouseStock          WarehouseStock[]
  hospitalRequests        HospitalRequest[]
  announcements           Announcement[]
  hospitalStock           HospitalStock[]
  interRequestsSent       HospitalInterRequest[]   @relation("RequesterHospitals")
  interRequestsReceived   HospitalInterRequest[]   @relation("ReceiverHospitals")
  samplesCollected        BloodSample[]            @relation("StationSamples")
  samplesTested           BloodSample[]            @relation("LabSamples")
  hospitalSamples         BloodSample[]            @relation("HospitalSamples")
  auditLogs               AuditLog[]
  appointments            Appointment[]
  patients                Patient[]
  bloodOrders             BloodOrder[]
  passwordResetRequests   PasswordResetRequest[]

  @@map("users")
}

model Donor {
  fayda_id           String        @id
  name               String
  phone              String        @unique
  dob                DateTime
  gender             String
  address            String
  blood_type         String
  last_donation_date DateTime?
  health_status      String        @default("unknown") // 'unknown', 'healthy', 'defective'
  points             Int           @default(0)
  user_id            String?       @unique

  // Relations
  user         User?         @relation("UserToDonor", fields: [user_id], references: [id], onDelete: SetNull)
  bloodSamples BloodSample[]
  appointments Appointment[]

  @@map("donors")
}

model BloodSample {
  id           String   @id @default(uuid())
  fayda_id     String
  blood_type   String
  status       String   @default("collected") // 'collected', 'pending_lab', 'validated', 'discarded'
  health_notes String?
  station_id   String
  lab_id       String?
  hospital_id  String?
  patient_id   String?
  collected_at DateTime @default(now())

  // Relations
  donor    Donor        @relation(fields: [fayda_id], references: [fayda_id], onDelete: Cascade)
  station  User         @relation("StationSamples", fields: [station_id], references: [id], onDelete: Cascade)
  lab      User?        @relation("LabSamples", fields: [lab_id], references: [id], onDelete: SetNull)
  hospital User?        @relation("HospitalSamples", fields: [hospital_id], references: [id], onDelete: SetNull)
  patient  Patient?     @relation(fields: [patient_id], references: [id], onDelete: SetNull)
  smsLogs  SentSmsLog[]

  @@map("blood_samples")
}

model WarehouseStock {
  id           String @id @default(uuid())
  warehouse_id String
  blood_type   String
  quantity     Int    @default(0)

  // Relations
  warehouse User   @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)

  @@unique([warehouse_id, blood_type])
  @@map("warehouse_stock")
}

model HospitalRequest {
  id           String   @id @default(uuid())
  hospital_id  String
  blood_type   String
  units_needed Int
  status       String   @default("pending") // 'pending', 'fulfilled', 'cancelled'
  created_at   DateTime @default(now())

  // Relations
  hospital    User        @relation(fields: [hospital_id], references: [id], onDelete: Cascade)
  bloodOrders BloodOrder[]

  @@map("hospital_requests")
}

model SentSmsLog {
  id              String   @id @default(uuid())
  phone           String
  blood_sample_id String
  message_type    String   // 'initial', 'encouragement', 'warning'
  sent_at         DateTime @default(now())

  // Relations
  sample BloodSample @relation(fields: [blood_sample_id], references: [id], onDelete: Cascade)

  @@unique([blood_sample_id, message_type])
  @@map("sent_sms_logs")
}

model EmailVerification {
  email      String   @id
  code       String
  expires_at DateTime
  verified   Boolean  @default(false)

  @@map("email_verifications")
}

model Announcement {
  id               String    @id @default(uuid())
  title            String
  content          String
  type             String    @default("campaign") // 'campaign', 'station'
  station_location String?
  start_date       DateTime?
  end_date         DateTime?
  created_at       DateTime  @default(now())
  warehouse_id     String

  // Relations
  warehouse User      @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)

  @@map("announcements")
}

model HospitalStock {
  id          String @id @default(uuid())
  hospital_id String
  blood_type  String
  quantity    Int    @default(0)

  // Relations
  hospital User   @relation(fields: [hospital_id], references: [id], onDelete: Cascade)

  @@unique([hospital_id, blood_type])
  @@map("hospital_stock")
}

model HospitalInterRequest {
  id           String   @id @default(uuid())
  requester_id String
  receiver_id  String?
  blood_type   String
  units_needed Int
  status       String   @default("pending") // 'pending', 'fulfilled', 'declined'
  created_at   DateTime @default(now())

  // Relations
  requester User     @relation("RequesterHospitals", fields: [requester_id], references: [id], onDelete: Cascade)
  receiver  User?    @relation("ReceiverHospitals", fields: [receiver_id], references: [id], onDelete: Cascade)

  @@map("hospital_inter_requests")
}

model AuditLog {
  id           String   @id @default(uuid())
  user_id      String
  action       String
  details      String
  ip_address   String?
  created_at   DateTime @default(now())

  // Relations
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model Appointment {
  id           String   @id @default(uuid())
  donor_id     String
  station_id   String
  date_time    DateTime
  status       String   @default("scheduled") // 'scheduled', 'completed', 'cancelled'
  created_at   DateTime @default(now())

  // Relations
  donor        Donor    @relation(fields: [donor_id], references: [fayda_id], onDelete: Cascade)
  station      User     @relation(fields: [station_id], references: [id], onDelete: Cascade)

  @@map("appointments")
}

model SmsQueue {
  id           String   @id @default(uuid())
  phone        String
  message      String
  status       String   @default("pending") // 'pending', 'sent', 'failed'
  retry_count  Int      @default(0)
  last_error   String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("sms_queue")
}

model Patient {
  id               String    @id @default(uuid())
  hospital_id      String
  full_name        String
  age              Int
  gender           String    // 'male', 'female', 'other'
  blood_type       String
  fayda_id         String?
  ward             String
  bed_number       String
  diagnosis        String?
  admission_status String    @default("admitted") // 'admitted', 'discharged'
  admitted_at      DateTime  @default(now())
  discharged_at    DateTime?

  // Relations
  hospital     User          @relation(fields: [hospital_id], references: [id], onDelete: Cascade)
  bloodOrders  BloodOrder[]
  bloodSamples BloodSample[]

  @@map("patients")
}

model BloodOrder {
  id              String    @id @default(uuid())
  patient_id      String
  hospital_id     String
  blood_type      String
  units_needed    Int
  urgency         String    @default("routine") // 'routine', 'urgent', 'emergency'
  status          String    @default("pending") // 'pending', 'requisition_placed', 'dispatched', 'transfused', 'cancelled'
  notes           String?
  requisition_id  String?
  ordered_at      DateTime  @default(now())
  transfused_at   DateTime?

  // Relations
  patient     Patient          @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  hospital    User             @relation(fields: [hospital_id], references: [id], onDelete: Cascade)
  requisition HospitalRequest? @relation(fields: [requisition_id], references: [id], onDelete: SetNull)

  @@map("blood_orders")
}

model PasswordResetRequest {
  id           String   @id @default(uuid())
  user_id      String
  email        String
  role         String
  entity_name  String
  status       String   @default("pending") // 'pending', 'resolved'
  created_at   DateTime @default(now())

  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("password_reset_requests")
}
